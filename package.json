{
  "name": "modelswap",
  "version": "1.0.68",
  "description": "ModelSwap — the key & model console for AI coding agents. Vault, provider switching, usage monitoring.",
  "main": "dist/main.js",
  "bin": {
    "modelswap": "dist/main.js"
  },
  "scripts": {
    "build": "tsc && npm run gen-presets && npm run build-extension && npm run copy-web && npm run verify-runtime && npm run build-frontend",
    "gen-presets": "node scripts/gen-presets.js",
    "copy-web": "node scripts/copy-web.js",
    "verify-runtime": "node scripts/verify-runtime-closure.js",
    "build-frontend": "cd src/web/frontend && npm ci && npm run build",
    "app:dev": "npm run build && electron dist/electron/main.js",
    "app:build": "npm run build && electron-builder --mac dir",
    "app:dist": "npm run build && electron-builder --mac dmg,zip",
    "app:install": "npm run app:build && APP_PATH=$(find release -maxdepth 3 -name 'ModelSwap.app' -type d | head -n 1) && test -n \"$APP_PATH\" && rm -rf /Applications/ModelSwap.app && cp -R \"$APP_PATH\" /Applications/ModelSwap.app",
    "dev": "ts-node src/main.ts",
    "dev:web": "cd src/web/frontend && npm run dev",
    "start": "node dist/main.js",
    "pretest": "tsc && npm run copy-web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:providers:live": "node scripts/provider-live-acceptance.mjs",
    "build-extension": "cd extension && npm ci && npm run build",
    "build:docs": "node scripts/build-docs-site.mjs",
    "deploy:docs": "npm run build:docs && npx wrangler deploy --config docs-wrangler.jsonc"
  },
  "files": [
    "dist/main.*",
    "dist/commands/**",
    "dist/application/**",
    "dist/config/**",
    "dist/infrastructure/**",
    "dist/providers/**",
    "dist/utils/**",
    "dist/vault/**",
    "dist/web/**",
    "extension/**",
    "!extension/node_modules",
    "skills/modelswap/**",
    "!dist/release",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "agent",
    "devtools",
    "installer",
    "infrastructure"
  ],
  "author": "dolphin-molt",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cing-self/modelswap.git"
  },
  "homepage": "https://github.com/Cing-self/modelswap#readme",
  "bugs": {
    "url": "https://github.com/Cing-self/modelswap/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.9",
    "commander": "^11.0.0",
    "execa": "^5.1.1",
    "express": "^5.2.1",
    "fs-extra": "^11.1.1",
    "js-yaml": "^4.3.1",
    "kleur": "^4.1.5",
    "ora": "^5.4.1",
    "prompts": "^2.4.2",
    "typebox": "^1.3.11",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.5.0",
    "@types/prompts": "^2.4.4",
    "@types/ws": "^8.18.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.11",
    "playwright": "^1.62.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.dolphin.modelswap",
    "productName": "ModelSwap",
    "asar": true,
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "asarUnpack": [
      "extension/manifest.json",
      "extension/clipboard.html",
      "extension/dist/**",
      "extension/icons/**"
    ],
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "dist/electron/main.js"
    },
    "files": [
      "dist/**/*",
      "extension/**",
      "!extension/node_modules",
      "!node_modules/@github/copilot-darwin-*/**/*",
      "!node_modules/@github/copilot-linux-*/**/*",
      "!node_modules/@github/copilot-win32-*/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "-"
    },
    "dmg": {
      "format": "UDBZ"
    }
  }
}
